# Copy to terraform.tfvars (git-ignored — the repo is public and OCIDs are
# identifying). Provider auth comes from ~/.oci/config, secrets from ../tf.sh.
compartment_ocid = "ocid1.compartment.oc1..CHANGE-ME"

vcn_ocid                    = "ocid1.vcn.oc1..CHANGE-ME"
subnet_ocid                 = "ocid1.subnet.oc1..CHANGE-ME"
internet_gateway_ocid       = "ocid1.internetgateway.oc1..CHANGE-ME"
route_table_ocid            = "ocid1.routetable.oc1..CHANGE-ME"
worker_instance_ocid        = "ocid1.instance.oc1..CHANGE-ME"
observability_instance_ocid = "ocid1.instance.oc1..CHANGE-ME"

vcn_cidr      = "10.0.0.0/16"
vcn_ipv6_cidr = "2603:c020:c014:4e00::/56"
