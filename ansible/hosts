[home]
zeus   ansible_host=192.168.0.3
hermes ansible_host=192.168.0.4

[home:vars]
ansible_user=distro

[cloud]
# Pinned to their static Oracle addresses. `.cloud` is a real public TLD, so
# these names only reach the right hosts where Pi-hole answers for them —
# without ansible_host an off-LAN run would connect to a stranger's server and,
# given StrictHostKeyChecking=accept-new, silently trust it.
observability.cloud ansible_host=132.226.210.138
worker.cloud        ansible_host=141.147.74.4

[cloud:vars]
ansible_user=ubuntu

[nomad]
zeus
hermes

[gatus]
observability.cloud

[tailscale]
# worker is deliberately absent: it serves the control plane over the public
# internet and must not depend on the tailnet it hands out.
hermes
observability.cloud

[headscale]
worker.cloud

[relay]
# worker is deliberately absent: it hosts the control plane and serves
# headscale on :443 directly, which would collide with the pass-through
# listener. Adding it back needs the ssl_preread SNI split first.
observability.cloud
