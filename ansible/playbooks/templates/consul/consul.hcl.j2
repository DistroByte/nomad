datacenter = "{{ nomad_datacenter_name }}"
data_dir = "/opt/consul"
encrypt = "{{ consul_encrypt_key }}"
bind_addr = "{% raw %}{{ GetPrivateInterfaces | include \"network\" \"192.168.0.0/24\" | attr \"address\" }}{% endraw %}"
client_addr = "0.0.0.0"

tls {
  defaults {
    ca_file   = "/etc/consul.d/tls/consul-agent-ca.pem"
    cert_file = "/etc/consul.d/tls/{{ nomad_datacenter_name }}-server-consul-0.pem"
    key_file  = "/etc/consul.d/tls/{{ nomad_datacenter_name }}-server-consul-0-key.pem"
    verify_incoming = true
    verify_outgoing = true
  }
  internal_rpc {
    verify_server_hostname = true
  }
}

auto_encrypt {
  allow_tls = true
}

# The other servers' ansible_host addresses, excluding this host (Consul cannot
# join itself). Addresses rather than names: a bare name goes through the
# resolv.conf search list and resolves first as <name>.node.consul, i.e. from
# Consul's own catalog - which after a renumber still holds the old address,
# and before the agent is up does not answer at all. The inventory is the one
# place a renumber has to change anyway.
retry_join = [{% for host in groups.nomad | difference([inventory_hostname]) %}"{{ hostvars[host].ansible_host }}"{{ ", " if not loop.last }}{% endfor %}]

acl {
  enabled = false
  default_policy = "allow"
  enable_token_persistence = true
}

performance {
  raft_multiplier = 1
}

recursors = ["192.168.0.5"] # adds DNS forwarding for non-`.consul` domains
