{# Static records for every inventory host, so the names this estate uses
   internally resolve without MagicDNS. That matters because these nodes no
   longer accept tailnet DNS: the .ts.dbyte.xyz heartbeat targets in jobs/ would
   otherwise stop resolving for containers the moment accept_dns went false. #}
{% set records = pihole_static_hosts | list %}
{% for host in groups['all'] | sort %}
{%   set hv = hostvars[host] %}
{%   if hv.ansible_host is defined %}
{%     set names = host if '.' in host else host ~ '.internal ' ~ host %}
{%     set _ = records.append(hv.ansible_host ~ ' ' ~ names) %}
{%   endif %}
{%   if hv.tailnet_ipv4 is defined %}
{%     set _ = records.append(hv.tailnet_ipv4 ~ ' ' ~ hv.tailscale_hostname ~ '.' ~ tailnet_base_domain) %}
{%   endif %}
{% endfor %}
# Managed by ansible/playbooks/pihole.yaml — edits here are overwritten.
#
# Every FTLCONF_* value below is a *forced* setting in Pi-hole v6: the API and
# UI show it read-only. That is the point — group_vars/pihole.yaml is the source
# of truth. Anything that must stay editable at runtime (notably
# misc.dnsmasq_lines, owned by scripts/sync-dns.sh) is deliberately absent.
TZ={{ pihole_timezone }}
FTLCONF_webserver_api_password={{ pihole_password }}
FTLCONF_webserver_port={{ pihole_web_port }}o,[::]:{{ pihole_web_port }}o

# ALL, not LOCAL: this resolver answers the LAN, the tailnet (100.64.0.0/10)
# and docker0, because the Docker daemon's `dns` points containers at
# 172.17.0.1. What limits reach is the port-53 firewall, not the listener.
FTLCONF_dns_listeningMode=all
FTLCONF_dns_upstreams={{ pihole_upstreams | join(';') }}
FTLCONF_dns_hosts={{ records | join(';') }}
FTLCONF_dns_domain=internal
FTLCONF_dns_expandHosts=false
FTLCONF_dns_dnssec=false

# Off, as on dionysus: these are cluster nodes, not a query archive.
FTLCONF_dns_queryLogging=false
FTLCONF_misc_etc_dnsmasq_d=false
