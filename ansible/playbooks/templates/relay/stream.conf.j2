# {{ ansible_managed }}
#
# L4 ingress relay. Terminates nothing — TLS is still terminated by Traefik on
# {{ relay_upstream_node }}, so certificates stay where ACME already issues them.

stream {
    log_format relay '$remote_addr [$time_local] $protocol $server_port '
                     '-> $upstream_addr $status '
                     'tx=$bytes_sent rx=$bytes_received dur=$session_time';

    access_log /var/log/nginx/relay.log relay;
    error_log  /var/log/nginx/relay-error.log warn;

    proxy_connect_timeout 5s;

    upstream traefik_https {
        server {{ relay_upstream_ip }}:{{ relay_upstream_https_port }};
    }

    upstream traefik_http {
        server {{ relay_upstream_ip }}:{{ relay_upstream_http_port }};
    }

    upstream traefik_voice {
        server {{ relay_upstream_ip }}:{{ relay_upstream_voice_port }};
    }

    # HTTPS. PROXY protocol preserves the client address, which Traefik reads
    # back on its websecure-proxied entrypoint.
    server {
        listen 443;
        proxy_pass traefik_https;
        proxy_protocol on;
        proxy_timeout {{ relay_https_timeout }};
    }

    # HTTP. Goes to Traefik's plain `web` entrypoint, whose only job is to
    # redirect to https://. No PROXY protocol: the client address is irrelevant
    # for a redirect, and `web` is not configured to expect a header.
    server {
        listen 80;
        proxy_pass traefik_http;
    }

    # Mumble. Latency matters more than attribution here, and Traefik's voice
    # entrypoints do not parse PROXY protocol, so pass both transports straight
    # through.
    server {
        listen {{ relay_upstream_voice_port }};
        proxy_pass traefik_voice;
    }

    server {
        listen {{ relay_upstream_voice_port }} udp;
        proxy_pass traefik_voice;
        proxy_timeout {{ relay_voice_timeout }};
    }
}
